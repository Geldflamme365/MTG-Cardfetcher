{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtg-remasurium",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./Remasurium",
    "binding": "ASSETS"
  },
  // Sobald Routes gesetzt sind, schaltet Wrangler die workers.dev-Adresse
  // ohne diese Zeile ab. Sie bleibt als Ausweichadresse bestehen.
  "workers_dev": true,
  // Custom Domains statt Routes: Cloudflare legt DNS-Eintrag und
  // Zertifikat selbst an und deckt jeden Pfad ab.
  "routes": [
    { "pattern": "remasurium.ch", "custom_domain": true },
    { "pattern": "www.remasurium.ch", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "remasurium",
      "database_id": "99a51fea-8503-4b9c-8838-419a4ef77be5"
    }
  ],
  "observability": {
    "enabled": true
  }
}
